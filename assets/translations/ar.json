  "auto_str_003": "تم تحديث الأسعار العالمية والتركية الآن بنجاح • جاري متابعة حركة الأسواق المحلية بدقة • توقعات بـ استقرار أسعار الذهب خلال الساعات القادمة • شكرًا لاستخدامكم تطبيق غولد شام V2 •",
  "auto_str_004": "يتحمل المستخدم المسؤولية الكاملة عن استخدامه للتطبيق والبيانات الواردة فيه. يجب التأكد من الأسعار من المصادر الرسمية قبل إجراء أي عمليات بيع أو شراء حقيقية.",
  "auto_str_005": "التطبيق يقدم أسعار الذهب والعملات للأغراض المعلوماتية فقط. نحن نسعى لتقديم أدق البيانات، ولكن لا نتحمل مسؤولية أي قرارات مالية تُتخذ بناءً على هذه الأسعار.",
  "auto_str_006": "نقوم بجمع الحد الأدنى من البيانات اللازمة لتشغيل التطبيق، مثل معرف الجهاز لتلقي التنبيهات، وتفضيلاتك (المفضلة) التي تُحفظ محلياً أو لغرض المزامنة.",
  "auto_str_007": "باستخدامك لتطبيق \"غولد شام\"، فإنك تقر وتوافق على الالتزام بشروط وأحكام هذه الاتفاقية. إذا كنت لا توافق على هذه الشروط، يرجى عدم استخدام التطبيق.",
  "auto_str_008": "يتم توفير الخدمة \"كما هي\" دون أي ضمانات صريحة أو ضمنية. نحن لا نتحمل مسؤولية أي خسائر ناتجة عن استخدام أو عدم القدرة على استخدام التطبيق.",
  "auto_str_009": "نحن في \"غولد شام\" نلتزم بحماية خصوصية بياناتك. توضح هذه السياسة كيفية جمعنا واستخدامنا وحماية معلوماتك الشخصية عند استخدامك لتطبيقنا.",
  "auto_str_010": "خطط لمستقبلك بالذهب وحقق أهدافك المالية (زواج، شراء سيارة، عقار أو تقاعد) باحتساب خطة الشراء التراكمي شهرياً وأسبوعياً.",
  "auto_str_011": "نحتفظ بالحق في تعديل هذه الشروط في أي وقت. استمرارك في استخدام التطبيق بعد هذه التعديلات يُعتبر قبولاً للشروط الجديدة.",
  "auto_str_012": "نحن لا نبيع أو نشارك معلوماتك الشخصية مع أطراف ثالثة لأغراض تسويقية. يتم استخدام البيانات فقط ضمن إطار خدمات التطبيق.",
  "auto_str_013": "نستخدم البيانات لتحسين تجربة المستخدم، إرسال تنبيهات الأسعار الفورية، وتحليل أداء التطبيق لضمان تقديم أفضل خدمة.",
  "auto_str_014": "إذا كان لديك أي استفسار حول سياسة الخصوصية، يمكنك التواصل معنا عبر قنوات التواصل الرسمية المتاحة في التطبيق.",
  "auto_str_015": "جميع المحتويات والشعارات والبرمجيات الخاصة بالتطبيق هي ملك \"غولد شام\" ومحمية بموجب قوانين الملكية الفكرية.",
  "auto_str_016": "تحويل فوري وشامل بين الأونصة العالمية، الغرام، التولة الهندية، المثقال الخليجي/العراقي والليرات الذهبية.",
  "auto_str_017": "أضف سبائكك أو مجوهراتك أو عملاتك الذهبية لمتابعة قيمتها وأرباحها لحظة بلحظة وبخصوصية تامة على جهازك.",
  "auto_str_018": "نعتذر، يوجد عطل في الاتصال بالخادم • يرجى التحقق من الشبكة • البيانات المعروضة هي آخر بيانات مسجلة •",
  "auto_str_019": "نحن نسعى لضمان توفر التطبيق على مدار الساعة، ولكن لا نضمن عدم حدوث انقطاعات تقنية خارجة عن إرادتنا.",
  "auto_str_020": "نشرة أسعار الذهب والعملات الرسمية اليومية - تطبيق ذهب الشام\\nتابع الأسعار الحية لحظة بلحظة.",
  "auto_str_021": "يتم احتساب زكاة الذهب بنسبة 2.5% بعد تحويل كافة العيارات إلى ما يعادلها من الذهب الخالص.",
  "auto_str_022": "قد نقوم بتحديث سياسة الخصوصية من وقت لآخر. سيتم إخطارك بأي تغييرات جوهرية عبر التطبيق.",
  "auto_str_023": "احسب نسبة أرباحك وعائد استثمارك بمقارنة سعر الشراء السابق مع سعر السوق الحي الحالي.",
  "auto_str_024": "سيتم رصد موجات الهبوط المتتالية وتنبيهك فور ظهور إشارة ارتداد وصعود لشراء القاع.",
  "auto_str_025": "نستخدم تقنيات تشفير ومعايير أمنية متقدمة لحماية بياناتك من الوصول غير المصرح به.",
